/* ============================================================
 * Clarity · 打印
 * ============================================================ */

@media print {
  .nav, .footer, .progress, .post-nav, .author-card,
  .toc-fab, .toc-drawer, .toc-backdrop,
  .cta, .seg, .code-bar, .skip-link, .lightbox, .noprint { display: none !important; }

  body { background: #fff; color: #000; font-size: 11.5pt; }
  .wrap { max-width: none; padding: 0; }
  .post-main { max-width: none; padding: 0; }
  .post-head { max-width: none; padding-top: 0; }
  .post-title { font-size: 22pt; }
  .article a { color: #000; border-bottom: none; }
  .highlight { border: 1px solid #ddd; break-inside: avoid; }
  .article h2, .article h3 { break-after: avoid; }
  .article img, .article table { break-inside: avoid; }
}
