/* ============================================================
 * Clarity · 左侧个人栏
 * ============================================================ */

.profile {
  position: sticky;
  top: calc(var(--nav-h) + 28px);
  align-self: start;
  padding: 24px 22px;
  border-radius: var(--r-lg);
}

.profile[data-sticky="false"] { position: static; }

.profile-head { display: flex; align-items: center; gap: 14px; }

/* 头像和名字保持原来的尺寸 —— 只有下面的统计换成了三项大号数字 */
.profile-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  object-fit: cover;
  flex: none;
  box-shadow: 0 0 0 1px var(--separator), 0 2px 10px rgba(0, 0, 0, 0.08);
}

.profile-id { min-width: 0; }

.profile-name {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.018em;
  margin: 0;
  line-height: 1.3;
}

.profile-tagline {
  font-size: 12px;
  line-height: 1.5;
  letter-spacing: 0;
  color: var(--text-3);
  margin: 4px 0 0;
  text-wrap: pretty;
}

.profile-bio {
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--text-2);
  margin: 16px 0 0;
}

/* 大号数字 + 下方小标签，三栏等宽 */
.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin: 20px 0 0;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 8px 2px;
  border-radius: var(--r-md);
  transition: background 0.25s var(--ease);
}
.stat:hover { background: var(--fill); }

.stat-n {
  font-size: 22px;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}
/* 三个数字各用一种色，和文章封面的渐变同一套色板 */
.stat:nth-child(1) .stat-n { color: #0a84ff; }
.stat:nth-child(2) .stat-n { color: #5e5ce6; }
.stat:nth-child(3) .stat-n { color: #bf5af2; }

.stat-l {
  font-size: 11.5px;
  line-height: 1.4;
  color: var(--text-3);
}

/* 窄屏：个人栏变成内容上方的一张横卡 */
@media (max-width: 1180px) {
  .profile {
    position: static;
    margin-bottom: 44px;
    padding: 20px 22px;
  }
  .profile-bio { margin-top: 14px; }
  .profile-stats { margin-top: 12px; }
}
