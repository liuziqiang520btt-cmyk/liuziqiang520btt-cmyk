- var sinceYear = (theme.footer && theme.footer.since) || new Date().getFullYear()
- var nowYear = new Date().getFullYear()
- var yearText = (sinceYear && sinceYear < nowYear) ? sinceYear + '–' + nowYear : String(nowYear)
footer.footer
  .wrap
    .footer-inner
      .footer-copy © #{yearText} #{config.author || config.title}
      nav.footer-links
        each furl, fname in theme.menu
          a(href=url_for(furl))= fname
      .footer-meta
        if theme.footer && theme.footer.statistics
          span #{site.posts.length} 篇
        if theme.footer && theme.footer.powered
          span Clarity
