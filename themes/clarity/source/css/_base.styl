/* ============================================================
 * Clarity · Reset & Base
 * ============================================================ */

*, *::before, *::after { box-sizing: border-box; }

html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  margin: 0;
  background-color: var(--bg);
  /* 极淡的环境光：给玻璃卡片一点可模糊的层次，也让页面不那么"死白" */
  background-image:
    radial-gradient(52% 38% at 82% -4%, var(--ambient-1), transparent 72%),
    radial-gradient(46% 34% at 6% 8%, var(--ambient-2), transparent 74%),
    radial-gradient(64% 42% at 50% 102%, var(--ambient-3), transparent 76%);
  background-repeat: no-repeat;
  color: var(--text);
  font-family: var(--font-sans);
  font-size: 17px;
  line-height: 1.47;
  letter-spacing: -0.01em;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  transition: background 0.4s var(--ease), color 0.4s var(--ease);
}

a { color: inherit; text-decoration: none; }
img { max-width: 100%; height: auto; display: block; }
button { font-family: inherit; }
svg { display: block; }

.wrap {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 24px;
}

/* 页面骨架：左侧个人栏 + 内容 */
.shell {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: var(--rail) minmax(0, 1fr);
  gap: var(--rail-gap);
  align-items: start;
}

body.no-rail .shell { grid-template-columns: minmax(0, 1fr); }

.shell-main { min-width: 0; }

@media (max-width: 1180px) {
  .shell { grid-template-columns: minmax(0, 1fr); gap: 0; }
}

::selection { background: var(--accent-soft); color: var(--text); }

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  z-index: 200;
  padding: 10px 18px;
  background: var(--accent);
  color: #fff;
  border-radius: 0 0 var(--r-md) 0;
}
.skip-link:focus { left: 0; }

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 4px;
}

.dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--text-3);
  opacity: 0.6;
  display: inline-block;
  flex: none;
}

.empty {
  color: var(--text-3);
  font-size: 15px;
  padding: 40px 0;
  text-align: center;
}

/* 滚动条 —— 尽量轻 */
* { scrollbar-width: thin; scrollbar-color: var(--fill-2) transparent; }
*::-webkit-scrollbar { width: 10px; height: 10px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb {
  background: var(--fill-2);
  border-radius: 8px;
  border: 3px solid transparent;
  background-clip: content-box;
}
