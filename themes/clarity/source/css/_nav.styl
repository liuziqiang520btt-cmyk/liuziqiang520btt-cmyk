/* ============================================================
 * Clarity · 导航栏（Liquid Glass 材质）
 * ============================================================ */

.nav {
  position: sticky;
  top: 0;
  z-index: 60;
  height: var(--nav-h);
  background: var(--nav-bg);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid var(--separator);
  transition: background 0.35s var(--ease), border-color 0.35s var(--ease);
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .nav { background: var(--bg); }
}

/* 首页有首屏封面时，导航栏脱离文档流压在图片上 */
body.has-cover .nav { position: fixed; top: 0; left: 0; right: 0; }

/* 还在封面范围内：导航栏完全透明、文字转白 */
html.is-over-cover .nav {
  background: transparent;
  border-bottom-color: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}
html.is-over-cover .nav .brand-name,
html.is-over-cover .nav-menu a,
html.is-over-cover .icon-btn { color: rgba(255, 255, 255, 0.92); }
html.is-over-cover .nav-menu a.on { color: #fff; }
html.is-over-cover .icon-btn { border-color: rgba(255, 255, 255, 0.42); }
html.is-over-cover .icon-btn:hover { background: rgba(255, 255, 255, 0.2); color: #fff; }
html.is-over-cover .brand .mark { box-shadow: inset 0 0.5px 0 rgba(255, 255, 255, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.3); }


.nav-inner {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 24px;
  height: 100%;
  display: flex;
  align-items: center;
  gap: 28px;
}

.brand {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  gap: 9px;
  flex: none;
}

.brand .mark {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  background: linear-gradient(145deg, #4facfe, #0071e3 60%, #5e5ce6);
  box-shadow: inset 0 0.5px 0 rgba(255, 255, 255, 0.5);
}

.brand .brand-img { width: 22px; height: 22px; border-radius: 6px; }
.brand .brand-name { white-space: nowrap; }

.nav-menu {
  display: flex;
  gap: 26px;
  margin-left: auto;
  font-size: 13px;
  color: var(--text-2);
}

.nav-menu a { transition: color 0.25s var(--ease); }
.nav-menu a:hover { color: var(--text); }
.nav-menu a.on { color: var(--text); font-weight: 500; }

.nav-tools { display: flex; align-items: center; gap: 10px; }

.icon-btn {
  width: 30px;
  height: 30px;
  border-radius: var(--r-pill);
  border: 1px solid var(--separator);
  background: transparent;
  color: var(--text-2);
  display: grid;
  place-items: center;
  cursor: pointer;
  padding: 0;
  transition: background 0.25s var(--ease), color 0.25s var(--ease);
}
.icon-btn:hover { background: var(--fill); color: var(--text); }
.icon-btn svg { width: 15px; height: 15px; }

.icon-btn .sun { display: none; }
[data-theme="dark"] .icon-btn .moon { display: none; }
[data-theme="dark"] .icon-btn .sun { display: block; }

.nav-burger { display: none; }

.nav-mobile {
  display: none;
  position: fixed;
  top: var(--nav-h);
  left: 0;
  right: 0;
  z-index: 58;
  flex-direction: column;
  /* 悬浮的液态玻璃面板：底色比普通卡片更透，能看见后面的背景图 */
  margin: 10px 12px 12px;
  padding: 6px 20px;
  border-radius: var(--r-xl);
  overflow: hidden;
  background: var(--glass-bg-float);
  -webkit-backdrop-filter: var(--glass-blur-float);
  backdrop-filter: var(--glass-blur-float);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .nav-mobile { background: var(--surface); }
}
.nav-mobile a {
  font-size: 15px;
  color: var(--text);
  padding: 12px 0;
}
.nav-mobile a.on { color: var(--accent); font-weight: 600; }
.nav-mobile.open { display: flex; }

@media (max-width: 860px) {
  .nav-menu { display: none; }
  .nav-burger { display: grid; }
  .nav-tools { margin-left: auto; }
}
